<templates xml:space="preserve">

<t t-name="goodahead_einvoice_base.EinvoiceAttentionMenu">
    <t t-if="state.total > 0">
        <Dropdown position="'bottom-end'" beforeOpen.bind="fetchAttention" state="dropdown">
            <button class="btn o-einvoice-attention-toggle" title="E-invoicing needs attention">
                <i class="fa fa-file-text-o text-danger" role="img" aria-label="E-invoicing needs attention"/>
                <span class="badge rounded-pill bg-danger ms-1" t-esc="state.total"/>
            </button>
            <t t-set-slot="content">
                <div class="o-einvoice-attention-menu d-flex flex-column overflow-auto" style="min-width: 320px; max-height: 400px;">
                    <t t-foreach="state.sections" t-as="section" t-key="section.key">
                        <div class="o-einvoice-attention-section d-flex flex-column" t-att-data-section="section.key">
                            <div class="d-flex justify-content-between align-items-center px-3 py-2 border-bottom bg-light">
                                <strong class="o-einvoice-attention-heading"><t t-esc="section.label"/> (<t t-esc="section.count"/>)</strong>
                                <a href="#" class="o-einvoice-attention-show-all ms-3 text-primary fw-bold"
                                   t-on-click.prevent="() => this.openSection(section)">Show all</a>
                            </div>
                            <div class="list-group list-group-flush">
                                <t t-foreach="section.items" t-as="item" t-key="item.id">
                                    <a href="#" class="o-einvoice-attention-item list-group-item list-group-item-action p-2 px-3"
                                       t-on-click.prevent="() => this.openItem(section, item)">
                                        <div class="fw-bold text-truncate">
                                            <t t-esc="item.title"/>
                                            <span t-if="item.badge" class="badge text-bg-light fw-normal ms-1" t-esc="item.badge"/>
                                        </div>
                                        <small t-if="item.subtitle" class="text-danger d-block text-truncate" t-esc="item.subtitle"/>
                                    </a>
                                </t>
                            </div>
                        </div>
                    </t>
                </div>
            </t>
        </Dropdown>
    </t>
</t>

</templates>
