<odoo>
    <!--
        THE QUEUE — where "Not now" goes.

        🔴 IT IS NOT PAULA'S LIST. The whole point of the thin line on the bill
        is that somebody entering a bill can hand the question on; this is where
        it lands, for whoever owns vendor data. Never her problem twice.

        The default filter is `state = pending` and the default grouping is by
        vendor, so one person can do a vendor at a time rather than a bill at a
        time — which is how the same correction stops arriving seven times.

        ⚠️ A `search_default_X` NAMING A FILTER THAT DOES NOT EXIST IS SILENTLY
        DROPPED. No error, no log line: you get an ungrouped list and conclude
        the grouping "did not work". The two names below are pinned by a test
        against the search view's own arch for exactly that reason.
    -->

    <record id="view_vendor_data_suggestion_list" model="ir.ui.view">
        <field name="name">goodahead.vendor.data.suggestion.list</field>
        <field name="model">goodahead.vendor.data.suggestion</field>
        <field name="arch" type="xml">
            <!-- 🔴 A MONEY DETAIL IS MARKED IN RED AND THE BULK BUTTON SKIPS
                 IT. Invoice fraud is a changed bank account, and vendor
                 invoices do carry printed warnings about that exact scam. -->
            <!-- 🔴 A ROW CLICK OPENS THE REVIEW DIALOG FOR THAT ROW'S VENDOR,
                 not a form on the one row. `action` + `type` on `<list>` is
                 core's own hook for it (`list_controller.js:361`, "custom open
                 action when clicking on record row"), and the 19.0 list RNG
                 allows both. A form on a single suggestion is the least useful
                 thing to look at: the question is never "is this phone number
                 right" on its own. -->
            <list create="false" action="action_open_review" type="object"
                  decoration-danger="is_sensitive"
                  decoration-muted="state == 'dismissed'">
                <header>
                    <button name="action_apply_selected" type="object"
                            string="Apply ticked" class="btn-primary"
                            help="Applies the ticked rows. A bank account or a tax id is left pending on purpose — select-all is one click, and a money detail should get somebody's individual attention."/>
                </header>
                <!-- 🔴 THREE OF THESE WERE CHANGED AFTER LOOKING AT THE LIST IN
                     A BROWSER, and none of it is visible from the arch.
                     * "Money detail" rendered as "Money d…" in the header.
                     * `note` is a sentence, and a visible Char column sizes to
                       its content: it took most of the row and squeezed the two
                       columns the whole screen exists for — "On this invoice"
                       read "ar@northwind…." and "(212) 555-0…". The note repeats
                       verbatim on every row of a kind, so it carries almost no
                       information per row; it is still one click away under the
                       optional-columns toggle.
                     * `partner_id` REPEATED THE GROUP HEADER on every row. The
                       action groups by vendor by default, so the vendor is
                       already written above the rows — the column was a second
                       copy of it, and it was taking width from the comparison.
                       `optional="hide"` rather than removed, because somebody
                       who ungroups the list needs it back and the toggle is one
                       click. ⚠️ An `optional` column is REMEMBERED PER USER in
                       `res.users.settings`, so changing this default does not
                       move a column for anybody who already touched it. -->
                <field name="partner_id" readonly="1" optional="hide"/>
                <field name="field_label" readonly="1" width="150px"/>
                <!-- No `width=` on these two, on purpose: they get whatever the
                     pinned columns leave, and they are what the screen is for. -->
                <field name="invoice_value" readonly="1"/>
                <field name="record_value" readonly="1"/>
                <field name="is_sensitive" string="Money" readonly="1"
                       width="80px"/>
                <field name="move_id" readonly="1" optional="show"
                       width="140px"/>
                <field name="note" optional="hide"/>
                <field name="state" readonly="1" widget="badge" width="110px"
                       decoration-info="state == 'pending'"
                       decoration-success="state == 'applied'"
                       decoration-muted="state == 'dismissed'"/>
                <field name="create_date" readonly="1" optional="hide"/>
                <button name="action_apply" type="object" string="Apply"
                        class="btn-link" icon="fa-check"
                        invisible="state != 'pending'"/>
                <button name="action_dismiss" type="object" string="Dismiss"
                        class="btn-link" icon="fa-times"
                        invisible="state != 'pending'"/>
            </list>
        </field>
    </record>

    <record id="view_vendor_data_suggestion_search" model="ir.ui.view">
        <field name="name">goodahead.vendor.data.suggestion.search</field>
        <field name="model">goodahead.vendor.data.suggestion</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="move_id"/>
                <field name="field_label"/>
                <field name="invoice_value"/>
                <!-- 🔴 THESE TWO NAMES ARE THE CONTRACT with the action's
                     context below. `pending` and `group_by_partner`. -->
                <filter name="pending" string="Pending"
                        domain="[('state', '=', 'pending')]"/>
                <filter name="applied" string="Applied"
                        domain="[('state', '=', 'applied')]"/>
                <filter name="dismissed" string="Dismissed"
                        domain="[('state', '=', 'dismissed')]"/>
                <separator/>
                <filter name="sensitive" string="Bank or tax id"
                        domain="[('is_sensitive', '=', True)]"/>
                <!-- ⚠️ A BARE `group`. 19.0's search RNG rejects both `expand`
                     and `string` on it — the install dies with
                     `RELAXNG_ERR_INVALIDATTR: Invalid attribute expand for
                     element group`, plus two cascading errors about the search
                     element that point nowhere near the cause. Core's own
                     19.0 search views carry a bare `group`
                     (`account/views/account_move_views.xml:1753`). -->
                <group>
                    <filter name="group_by_partner" string="Vendor"
                            context="{'group_by': 'partner_id'}"/>
                    <filter name="group_by_field" string="Detail"
                            context="{'group_by': 'field_label'}"/>
                    <filter name="group_by_state" string="State"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_vendor_data_suggestion" model="ir.actions.act_window">
        <field name="name">Vendor Data Suggestions</field>
        <field name="res_model">goodahead.vendor.data.suggestion</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_vendor_data_suggestion_search"/>
        <field name="context">{'search_default_pending': 1, 'search_default_group_by_partner': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nothing is waiting.</p>
            <p>
                Every imported bill fills in what the vendor record was missing
                by itself. What lands here is the other half: a detail on an
                invoice that CONTRADICTS the vendor, and the two that always
                wait for a person — a bank account and a tax id.
            </p>
        </field>
    </record>

    <!-- Beside `menu_ai_invoice_import`, under Accounting → Vendors, because
         that is where the module's own imports already live and it is where an
         accounting manager is when they care about a vendor record. -->
    <menuitem
        id="menu_vendor_data_suggestion"
        name="Vendor Data Suggestions"
        parent="account.menu_finance_payables"
        action="action_vendor_data_suggestion"
        sequence="101"
        groups="account.group_account_user,account.group_account_manager"
    />
</odoo>
