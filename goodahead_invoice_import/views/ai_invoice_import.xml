<odoo>
    <!--
        SCR-01 Inbox and SCR-02 Import record (core/source split). The xml ids keep
        the AI import's names so bookmarks, inheriting views and the action's
        menu keep working; what they show is every source's import records.
    -->
    <record id="view_ai_invoice_import_tree" model="ir.ui.view">
        <field name="name">goodahead.invoice.import.tree</field>
        <field name="model">goodahead.invoice.import</field>
        <field name="arch" type="xml">
            <!-- Rows processing for more than 30 minutes are highlighted. -->
            <list decoration-warning="processing_stale" decoration-muted="state == 'closed'">
                <!-- The status users see is derived from the job. -->
                <field name="display_state" widget="badge"
                    decoration-info="display_state == 'waiting'"
                    decoration-warning="display_state in ('processing', 'duplicate', 'possibly_lost')"
                    decoration-success="display_state == 'imported'"
                    decoration-danger="display_state == 'failed'"
                    decoration-muted="display_state == 'closed'"
                />
                <field name="state" column_invisible="1"/>
                <field name="processing_stale" column_invisible="1"/>
                <field name="source"/>
                <field name="reader" optional="hide"/>
                <field name="seller_name"/>
                <field name="invoice_number"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="amount_total"/>
                <field name="invoice_date"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
                <field name="create_date" string="Created"/>
                <field name="name" optional="hide"/>
                <field name="source_email" optional="hide"/>
                <field name="move_id" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_ai_invoice_import_search" model="ir.ui.view">
        <field name="name">goodahead.invoice.import.search</field>
        <field name="model">goodahead.invoice.import</field>
        <field name="arch" type="xml">
            <search>
                <field name="seller_name"/>
                <field name="invoice_number"/>
                <field name="name"/>
                <field name="move_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <filter name="unsettled" string="Unsettled"
                        domain="[('state', 'in', ('waiting', 'failed', 'duplicate', 'possibly_lost'))]"/>
                <separator/>
                <filter name="failed" string="Failed"
                        domain="[('state', '=', 'failed')]"/>
                <filter name="duplicate" string="Duplicate"
                        domain="[('state', '=', 'duplicate')]"/>
                <filter name="possibly_lost" string="Possibly lost"
                        domain="[('state', '=', 'possibly_lost')]"/>
                <filter name="processing_too_long" string="Processing too long"
                        domain="[('processing_stale', '=', True)]"/>
                <separator/>
                <filter name="imported" string="Imported"
                        domain="[('state', '=', 'imported')]"/>
                <filter name="closed" string="Closed without bill"
                        domain="[('state', '=', 'closed')]"/>
                <separator/>
                <filter name="source_upload" string="Upload"
                        domain="[('source', '=', 'upload')]"/>
                <filter name="source_email" string="Email"
                        domain="[('source', '=', 'email')]"/>
                <group>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_source" string="Source" context="{'group_by': 'source'}"/>
                    <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"
                            groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_ai_invoice_import_form" model="ir.ui.view">
        <field name="name">goodahead.invoice.import.form</field>
        <field name="model">goodahead.invoice.import</field>
        <field name="arch" type="xml">
            <!-- SCR-02: one banner per state and only the buttons that state allows. -->
            <form>
                <header>
                    <field name="state" invisible="1"/>
                    <field name="processing_stale" invisible="1"/>
                    <field name="failure_kind" invisible="1"/>
                    <button
                        name="action_retry"
                        type="object"
                        string="Retry"
                        class="btn-primary"
                        invisible="state not in ('failed', 'waiting') or move_id or display_state == 'processing'"
                    />
                    <button
                        name="action_override_duplicate"
                        type="object"
                        string="Create bill anyway"
                        class="btn-primary"
                        invisible="state != 'duplicate' or display_state == 'processing'"
                    />
                    <button
                        name="action_import_possibly_lost"
                        type="object"
                        string="Import"
                        class="btn-primary"
                        invisible="state != 'possibly_lost' or display_state == 'processing'"
                    />
                    <button
                        name="action_reimport_from_json"
                        type="object"
                        string="Re-import from JSON"
                        help="Re-run the import from the invoice data below without reading the document again. Fix the data first (e.g. add a missing date)."
                        invisible="state != 'failed' or failure_kind == 'interrupted' or not extraction_data or move_id or display_state == 'processing'"
                    />
                    <button
                        name="action_open_close_dialog"
                        type="object"
                        string="Close without bill"
                        invisible="state in ('imported', 'closed') or display_state == 'processing'"
                    />
                    <button
                        name="action_reopen"
                        type="object"
                        string="Reopen"
                        invisible="state != 'closed' or move_id"
                    />
                    <field name="display_state" widget="statusbar"
                        statusbar_visible="waiting,processing,imported"
                    />
                </header>
                <div name="banner_failed_data" class="alert alert-danger mb-0" role="alert"
                     invisible="state != 'failed' or failure_kind == 'interrupted'">
                    <field name="error_message" readonly="1"/>
                </div>
                <div name="banner_failed_interrupted" class="alert alert-warning mb-0" role="alert"
                     invisible="state != 'failed' or failure_kind != 'interrupted' or display_state == 'processing'">
                    <strong>Interrupted by a temporary problem, not by the invoice data.</strong>
                    Retry it once the problem has passed; a source that fetches on a
                    schedule may also retry it on its next run.
                    <field name="error_message" readonly="1"/>
                </div>
                <div name="banner_duplicate" class="alert alert-warning mb-0" role="alert"
                     invisible="state != 'duplicate'">
                    This invoice looks like one that already has a bill:
                    <field name="duplicate_of_move_id" readonly="1"/>.
                    Create the bill anyway if it really is a second invoice, or close it without a bill.
                </div>
                <div name="banner_possibly_lost" class="alert alert-warning mb-0" role="alert"
                     invisible="state != 'possibly_lost'">
                    Its source shows this invoice as received, but no bill exists for it.
                    Import it, or close it without a bill.
                </div>
                <div name="banner_processing_stale" class="alert alert-warning mb-0" role="alert"
                     invisible="display_state != 'processing' or not processing_stale">
                    Processing for more than 30 minutes; the job may be waiting to be requeued.
                </div>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_bill" type="object"
                                class="oe_stat_button" icon="fa-file-text-o"
                                invisible="not move_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Bill</span>
                            </div>
                        </button>
                        <button name="action_open_duplicate_bill" type="object"
                                class="oe_stat_button" icon="fa-files-o"
                                invisible="state != 'duplicate' or not duplicate_of_move_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Existing bill</span>
                            </div>
                        </button>
                    </div>
                    <group>
                        <group name="group_source" string="Source">
                            <field name="name"/>
                            <field name="source"/>
                            <field name="reader" invisible="not reader"/>
                            <field name="source_email" invisible="not source_email"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="journal_id" invisible="not journal_id"/>
                            <field name="pdf_attachment_id"/>
                            <field name="create_date" string="Created"/>
                        </group>
                        <group name="group_invoice" string="Invoice">
                            <field name="seller_name"/>
                            <field name="invoice_number"/>
                            <field name="einvoice_order_reference"
                                   invisible="not einvoice_order_reference"/>
                            <field name="einvoice_buyer_reference"
                                   invisible="not einvoice_buyer_reference"/>
                            <field name="invoice_date"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="amount_total"/>
                        </group>
                        <group name="group_result" string="Result">
                            <field name="move_id"/>
                            <field name="xml_attachment_id"/>
                        </group>
                    </group>
                    <group name="group_closed" string="Closed without bill" invisible="state != 'closed'">
                        <field name="close_reason"/>
                        <field name="closed_by_id"/>
                        <field name="closed_date"/>
                    </group>
                    <group string="Invoice data" invisible="not extraction_data">
                        <div class="text-muted" invisible="state != 'failed'" colspan="2">
                            Editable while failed — fix the data (e.g. add a missing
                            date), then use "Re-import from JSON".
                        </div>
                        <field name="extraction_data" nolabel="1" colspan="2"
                            widget="text" readonly="state != 'failed'"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_ai_invoice_import" model="ir.actions.act_window">
        <field name="name">Incoming invoices</field>
        <field name="res_model">goodahead.invoice.import</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_ai_invoice_import_search"/>
        <field name="context">{'search_default_unsettled': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">No incoming invoices yet</p>
            <p>
                Vendor invoices arrive here from uploads, email and connected
                e-invoicing operators. Administrators connect a source in the
                Accounting settings.
            </p>
        </field>
    </record>

    <!-- SCR-01 replaces the AI import's list entry; same xml id. -->
    <menuitem
        id="menu_ai_invoice_import"
        name="Incoming invoices"
        parent="account.menu_finance_payables"
        action="action_ai_invoice_import"
        sequence="5"
        groups="account.group_account_user,account.group_account_manager"
    />
</odoo>
