<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Plain arch, no custom widgets. Every conditional element carries a unique CSS class so
        `tests/test_ui.py` can extract and evaluate its `invisible` expression per record.
    -->

    <record id="view_move_form_bill_approval" model="ir.ui.view">
        <field name="name">account.move.form.bill.approval</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            <!-- Approval buttons go before Post/Confirm. Anchored positionally: Odoo refuses
                 translated attributes such as `@string` as inheritance selectors. -->
            <xpath expr="//header/button[@name='action_post'][1]"
                   position="before">
                <field name="bill_approval_state" invisible="1"/>
                <button name="action_bill_approval_1_dialog" type="object"
                        string="Send for Review"
                        class="btn-primary o_bill_approval_btn_1"
                        groups="goodahead_bill_approval.group_bill_approval_1"
                        invisible="move_type not in ('in_invoice', 'in_refund', 'out_refund') or state != 'draft' or approval_1_uid"
                        title="Approval step 1: the vendor, the dates, the lines and the accounts on this bill are right."/>
                <button name="action_bill_approval_2" type="object"
                        string="Approve"
                        class="btn-primary o_bill_approval_btn_2"
                        groups="goodahead_bill_approval.group_bill_approval_2"
                        invisible="move_type not in ('in_invoice', 'in_refund', 'out_refund') or state != 'draft' or not approval_1_uid or approval_2_uid"
                        title="Approval step 2: we agree to pay this bill. It can be posted once this is given."/>
                <button name="action_bill_approval_refuse" type="object"
                        string="Refuse"
                        class="o_bill_approval_btn_refuse"
                        groups="goodahead_bill_approval.group_bill_approval_1,goodahead_bill_approval.group_bill_approval_2"
                        invisible="move_type not in ('in_invoice', 'in_refund', 'out_refund') or state != 'draft' or bill_approval_state == 'to_review'"
                        title="Clear both approvals and send this bill back to the review queue, with a reason."/>
            </xpath>

            <!-- Right below the header, above core's own alerts. -->
            <xpath expr="//header" position="after">
                <div class="alert alert-warning o_bill_approval_alert_1" role="alert"
                     invisible="move_type not in ('in_invoice', 'in_refund', 'out_refund') or state != 'draft' or bill_approval_state != 'to_review'">
                    <b>This document has not been reviewed.</b>
                    Vendor bills and credit notes are reviewed (step 1) and then approved
                    (step 2) before they are posted, so this one is not in the ledger, not in
                    the partner's balance and cannot be paid or settled yet.
                </div>
                <div class="alert alert-info o_bill_approval_alert_2" role="alert"
                     invisible="move_type not in ('in_invoice', 'in_refund', 'out_refund') or state != 'draft' or bill_approval_state != 'reviewed'">
                    <b>Reviewed, waiting for approval.</b>
                    The figures have been checked. It still needs approval step 2 before it
                    can be posted.
                </div>
            </xpath>

            <!-- Who approved and when; each pair shows only once set. -->
            <xpath expr="//group[@id='header_right_group']" position="inside">
                <!-- Read-only for users without a level and once step 2 is given; the server
                     refuses both anyway (`_bill_approval_guard_approver`). -->
                <field name="bill_approval_user_may_set_approver" invisible="1"/>
                <field name="bill_approval_approver_id"
                       class="o_bill_approval_approver"
                       placeholder="Anyone holding step 2"
                       options="{'no_create': True}"
                       invisible="move_type not in ('in_invoice', 'in_refund', 'out_refund')"
                       readonly="not bill_approval_user_may_set_approver or state != 'draft' or approval_2_uid"/>
                <div class="o_td_label o_bill_approval_label_1"
                     invisible="not approval_1_uid">
                    <label for="approval_1_uid" string="Reviewed by"/>
                </div>
                <div class="d-flex o_bill_approval_given_1" invisible="not approval_1_uid">
                    <field name="approval_1_uid" nolabel="1" class="oe_inline"/>
                    <span class="o_form_label mx-2 text-muted">on</span>
                    <field name="approval_1_date" nolabel="1" class="oe_inline"/>
                </div>
                <div class="o_td_label o_bill_approval_label_2"
                     invisible="not approval_2_uid">
                    <label for="approval_2_uid" string="Approved by"/>
                </div>
                <!-- "on behalf of" shows only when a substitute gave step 2. -->
                <div class="d-flex o_bill_approval_given_2" invisible="not approval_2_uid">
                    <field name="approval_2_uid" nolabel="1" class="oe_inline"/>
                    <span class="o_form_label mx-2 text-muted o_bill_approval_on_behalf_label"
                          invisible="not approval_2_on_behalf_uid">on behalf of</span>
                    <field name="approval_2_on_behalf_uid" nolabel="1"
                           class="oe_inline o_bill_approval_on_behalf"
                           invisible="not approval_2_on_behalf_uid"/>
                    <span class="o_form_label mx-2 text-muted">on</span>
                    <field name="approval_2_date" nolabel="1" class="oe_inline"/>
                </div>
            </xpath>
        </field>
    </record>

    <!-- Approval state in the invoice list, hidden on customer-invoice lists by
         `column_invisible`. -->
    <record id="view_invoice_tree_bill_approval" model="ir.ui.view">
        <field name="name">account.invoice.list.bill.approval</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='status_in_payment']" position="before">
                <field name="bill_approval_state"
                       string="Approval"
                       widget="badge"
                       decoration-warning="bill_approval_state == 'to_review'"
                       decoration-info="bill_approval_state == 'reviewed'"
                       decoration-success="bill_approval_state == 'approved'"
                       column_invisible="context.get('default_move_type') not in ('in_invoice', 'in_refund', 'out_refund')"
                       invisible="state != 'draft'"
                       optional="show"/>
            </xpath>
        </field>
    </record>

    <!--
        Customer credit note queues and shared filters. `view_account_invoice_filter` is also
        the parent of the bill search view, so "My Approvals" and the group-by reach both, and
        the bill view removes the credit note filters again. Domains must match
        `CREDIT_NOTE_QUEUE_*_DOMAIN` in Python (checked by `tests/test_systray.py`).
    -->
    <record id="view_account_invoice_filter_approval" model="ir.ui.view">
        <field name="name">account.invoice.select.approval</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml">
            <filter name="out_refund" position="after">
                <separator/>
                <filter name="credit_note_awaiting_review"
                        string="Waiting for Review"
                        domain="[('bill_approval_state', '=', 'to_review'), ('state', '=', 'draft'), ('move_type', 'in', ['out_refund'])]"
                        help="Customer credit notes nobody has reviewed yet — approval step 1."/>
                <filter name="credit_note_awaiting_approval"
                        string="Waiting for Approval"
                        domain="[('bill_approval_state', '=', 'reviewed'), ('state', '=', 'draft'), ('move_type', 'in', ['out_refund']), '|', '|', ('bill_approval_approver_id', '=', False), ('bill_approval_approver_id', '=', uid), ('bill_approval_approver_id.bill_approval_substitute_id', '=', uid)]"
                        help="Customer credit notes that have been reviewed and that YOU can approve: no approver was chosen, or you are the chosen approver or their substitute."/>
                <filter name="credit_note_approved_to_post"
                        string="Approved, to Post"
                        domain="[('bill_approval_state', '=', 'approved'), ('auto_post', '=', 'no'), ('state', '=', 'draft'), ('move_type', 'in', ['out_refund'])]"
                        help="Customer credit notes that carry both approvals and are still draft."/>
                <separator/>
                <!-- Combine with Waiting for Approval to get the documents waiting for you. -->
                <filter name="bill_my_approvals"
                        string="My Approvals"
                        domain="['|', ('bill_approval_approver_id', '=', uid), ('bill_approval_approver_id.bill_approval_substitute_id', '=', uid)]"
                        help="Documents you were chosen to approve, or that were chosen for someone whose substitute you are."/>
            </filter>
            <filter name="status" position="after">
                <filter name="groupby_bill_approval_state" string="Approval"
                        context="{'group_by': 'bill_approval_state'}"/>
            </filter>
        </field>
    </record>

    <!--
        The bill queues. Each domain is complete (move type, draft state, approval state) and
        must match `BILL_APPROVAL_QUEUES` in Python, which feeds the systray counts; checked by
        `tests/test_systray.py`. The draft clause keeps bills posted before installation out.
    -->
    <record id="view_account_bill_filter_approval" model="ir.ui.view">
        <field name="name">account.bill.select.approval</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_bill_filter"/>
        <field name="arch" type="xml">
            <filter name="in_refund" position="after">
                <separator/>
                <filter name="bill_awaiting_review"
                        string="Waiting for Review"
                        domain="[('bill_approval_state', '=', 'to_review'), ('state', '=', 'draft'), ('move_type', 'in', ['in_invoice', 'in_refund'])]"
                        help="Vendor bills nobody has reviewed yet — approval step 1."/>
                <filter name="bill_awaiting_approval"
                        string="Waiting for Approval"
                        domain="[('bill_approval_state', '=', 'reviewed'), ('state', '=', 'draft'), ('move_type', 'in', ['in_invoice', 'in_refund']), '|', '|', ('bill_approval_approver_id', '=', False), ('bill_approval_approver_id', '=', uid), ('bill_approval_approver_id.bill_approval_substitute_id', '=', uid)]"
                        help="Vendor bills that have been reviewed and that YOU can approve: no approver was chosen, or you are the chosen approver or their substitute."/>
                <!-- Bills set to post themselves on their accounting date (`auto_post`) are not
                     waiting for anyone. Matches `BILL_QUEUE_TO_POST_DOMAIN`. -->
                <filter name="bill_approved_to_post"
                        string="Approved, to Post"
                        domain="[('bill_approval_state', '=', 'approved'), ('auto_post', '=', 'no'), ('state', '=', 'draft'), ('move_type', 'in', ['in_invoice', 'in_refund'])]"
                        help="Vendor bills that carry both approvals and are still draft — the bookkeeper posts them, then takes them to payment."/>
            </filter>
            <!-- Inherited from the customer search view (`mode=primary`); removed here. -->
            <filter name="credit_note_awaiting_review" position="replace"/>
            <filter name="credit_note_awaiting_approval" position="replace"/>
            <filter name="credit_note_approved_to_post" position="replace"/>
        </field>
    </record>

    <!-- The queues as menu items. Every `search_default_*` key must name an existing
         filter: the web client silently drops unknown keys (checked by `tests/test_queues.py`). -->
    <record id="action_bills_awaiting_review" model="ir.actions.act_window">
        <field name="name">Bills to Review</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="view_id" ref="account.view_in_invoice_bill_tree"/>
        <field name="search_view_id" ref="account.view_account_bill_filter"/>
        <field name="domain">[('move_type', 'in', ['in_invoice', 'in_refund'])]</field>
        <field name="context">{'default_move_type': 'in_invoice', 'search_default_bill_awaiting_review': 1, 'display_account_trust': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Nothing is waiting to be reviewed
            </p><p>
                A vendor bill lands here as soon as it is created, and leaves it when
                someone presses Send for Review.
            </p>
        </field>
    </record>

    <record id="action_bills_awaiting_approval" model="ir.actions.act_window">
        <field name="name">Bills to Approve</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="view_id" ref="account.view_in_invoice_bill_tree"/>
        <field name="search_view_id" ref="account.view_account_bill_filter"/>
        <field name="domain">[('move_type', 'in', ['in_invoice', 'in_refund'])]</field>
        <field name="context">{'default_move_type': 'in_invoice', 'search_default_bill_awaiting_approval': 1, 'display_account_trust': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Nothing is waiting for approval
            </p><p>
                A reviewed bill waits here until it is approved, and can be posted
                afterwards.
            </p>
        </field>
    </record>

    <!-- Approved and still draft: a bill leaves this queue by being posted. Payment is left
         to core's own payment flow. -->
    <record id="action_bills_to_post" model="ir.actions.act_window">
        <field name="name">Bills to Post</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="view_id" ref="account.view_in_invoice_bill_tree"/>
        <field name="search_view_id" ref="account.view_account_bill_filter"/>
        <field name="domain">[('move_type', 'in', ['in_invoice', 'in_refund'])]</field>
        <field name="context">{'default_move_type': 'in_invoice', 'search_default_bill_approved_to_post': 1, 'display_account_trust': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Nothing is waiting to be posted
            </p><p>
                A bill lands here the moment it collects approval step 2, and leaves it
                when it is posted. Posting it is what makes it payable.
            </p>
        </field>
    </record>

    <menuitem id="menu_bills_awaiting_review"
              parent="account.menu_finance_payables"
              action="action_bills_awaiting_review"
              groups="goodahead_bill_approval.group_bill_approval_1"
              sequence="3"/>
    <menuitem id="menu_bills_awaiting_approval"
              parent="account.menu_finance_payables"
              action="action_bills_awaiting_approval"
              groups="goodahead_bill_approval.group_bill_approval_2"
              sequence="4"/>
    <!-- Gated on the review level: posting is the reviewer's job. -->
    <menuitem id="menu_bills_to_post"
              parent="account.menu_finance_payables"
              action="action_bills_to_post"
              groups="goodahead_bill_approval.group_bill_approval_1"
              sequence="5"/>

    <!-- The same three queues for customer credit notes, under Customers, with their own
         actions so each systray row opens exactly what it counted. -->
    <record id="action_credit_notes_awaiting_review" model="ir.actions.act_window">
        <field name="name">Credit Notes to Review</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="view_id" ref="account.view_out_credit_note_tree"/>
        <field name="search_view_id" ref="account.view_account_invoice_filter"/>
        <field name="domain">[('move_type', 'in', ['out_refund'])]</field>
        <field name="context">{'default_move_type': 'out_refund', 'search_default_credit_note_awaiting_review': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No credit note is waiting to be reviewed
            </p><p>
                A customer credit note lands here as soon as it is created, and leaves it
                when someone presses Send for Review.
            </p>
        </field>
    </record>

    <record id="action_credit_notes_awaiting_approval" model="ir.actions.act_window">
        <field name="name">Credit Notes to Approve</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="view_id" ref="account.view_out_credit_note_tree"/>
        <field name="search_view_id" ref="account.view_account_invoice_filter"/>
        <field name="domain">[('move_type', 'in', ['out_refund'])]</field>
        <field name="context">{'default_move_type': 'out_refund', 'search_default_credit_note_awaiting_approval': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No credit note is waiting for approval
            </p><p>
                A reviewed credit note waits here until it is approved, and can be posted
                afterwards.
            </p>
        </field>
    </record>

    <record id="action_credit_notes_to_post" model="ir.actions.act_window">
        <field name="name">Credit Notes to Post</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="view_id" ref="account.view_out_credit_note_tree"/>
        <field name="search_view_id" ref="account.view_account_invoice_filter"/>
        <field name="domain">[('move_type', 'in', ['out_refund'])]</field>
        <field name="context">{'default_move_type': 'out_refund', 'search_default_credit_note_approved_to_post': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No credit note is waiting to be posted
            </p><p>
                A credit note lands here the moment it collects approval step 2, and leaves
                it when it is posted.
            </p>
        </field>
    </record>

    <menuitem id="menu_credit_notes_awaiting_review"
              parent="account.menu_finance_receivables"
              action="action_credit_notes_awaiting_review"
              groups="goodahead_bill_approval.group_bill_approval_1"
              sequence="3"/>
    <menuitem id="menu_credit_notes_awaiting_approval"
              parent="account.menu_finance_receivables"
              action="action_credit_notes_awaiting_approval"
              groups="goodahead_bill_approval.group_bill_approval_2"
              sequence="4"/>
    <menuitem id="menu_credit_notes_to_post"
              parent="account.menu_finance_receivables"
              action="action_credit_notes_to_post"
              groups="goodahead_bill_approval.group_bill_approval_1"
              sequence="5"/>
</odoo>
