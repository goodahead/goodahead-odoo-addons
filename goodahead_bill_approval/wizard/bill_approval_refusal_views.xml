<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bill_approval_refusal_form" model="ir.ui.view">
        <field name="name">bill.approval.refusal.form</field>
        <field name="model">bill.approval.refusal</field>
        <field name="arch" type="xml">
            <form string="Refuse this document">
                <!-- The consequence first, because the reason box is the only thing the
                     person who has to fix this document will have to work from. -->
                <div class="alert alert-warning" role="alert">
                    Refusing clears <b>both</b> approvals and returns this document to the
                    review queue. Nothing is cancelled and nothing is reversed — it was never
                    posted. A chosen approver stays chosen.
                </div>
                <group>
                    <field name="move_id" readonly="1" options="{'no_open': True}"/>
                </group>
                <group>
                    <field name="reason" nolabel="1" colspan="2"
                           placeholder="What is wrong with this document? For example: the freight line is billed twice, or the PO number on page 2 is not ours."/>
                </group>
                <footer>
                    <button name="action_refuse" type="object" string="Refuse"
                            class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"
                            data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
