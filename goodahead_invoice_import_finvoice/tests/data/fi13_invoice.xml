<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!-- Invented fixture: a Finvoice 1.3 invoice as some operators still deliver
     it. The rows carry a discount and are already net of
     it; no row has a VAT rate or a VAT amount and there is no VAT breakdown, so
     the one rate (25.5 %) comes from the header's VAT and VAT-exclusive totals:
     75.00 x 25.5 % = 19.125, stated 19.13. -->
<Finvoice Version="1.3" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="Finvoice.xsd">
  <SellerPartyDetails>
    <SellerPartyIdentifier>0000003-5</SellerPartyIdentifier>
    <SellerOrganisationName>Example Supplier Oy</SellerOrganisationName>
    <SellerOrganisationTaxCode>FI00000035</SellerOrganisationTaxCode>
  </SellerPartyDetails>
  <BuyerPartyDetails>
    <BuyerOrganisationName>Example Buyer Oy</BuyerOrganisationName>
  </BuyerPartyDetails>
  <InvoiceDetails>
    <InvoiceTypeCode>INV01</InvoiceTypeCode>
    <InvoiceTypeText>LASKU</InvoiceTypeText>
    <OriginCode>Original</OriginCode>
    <InvoiceNumber>13-1</InvoiceNumber>
    <InvoiceDate Format="CCYYMMDD">20261001</InvoiceDate>
    <InvoiceTotalVatExcludedAmount AmountCurrencyIdentifier="EUR">75,00</InvoiceTotalVatExcludedAmount>
    <InvoiceTotalVatAmount AmountCurrencyIdentifier="EUR">19,13</InvoiceTotalVatAmount>
    <InvoiceTotalVatIncludedAmount AmountCurrencyIdentifier="EUR">94,13</InvoiceTotalVatIncludedAmount>
    <PaymentTermsDetails>
      <PaymentTermsFreeText>14 pv netto</PaymentTermsFreeText>
      <InvoiceDueDate Format="CCYYMMDD">20261015</InvoiceDueDate>
    </PaymentTermsDetails>
  </InvoiceDetails>
  <InvoiceRow>
    <ArticleIdentifier>EX-100</ArticleIdentifier>
    <ArticleName>Hylly</ArticleName>
    <InvoicedQuantity QuantityUnitCode="kpl">2</InvoicedQuantity>
    <UnitPriceAmount AmountCurrencyIdentifier="EUR">50,00</UnitPriceAmount>
    <RowPositionIdentifier>1</RowPositionIdentifier>
    <RowDiscountPercent>40,000</RowDiscountPercent>
    <RowDiscountAmount AmountCurrencyIdentifier="EUR">40,00</RowDiscountAmount>
    <RowVatExcludedAmount AmountCurrencyIdentifier="EUR">60,00</RowVatExcludedAmount>
  </InvoiceRow>
  <InvoiceRow>
    <ArticleIdentifier>EX-200</ArticleIdentifier>
    <ArticleName>Kiinnike</ArticleName>
    <InvoicedQuantity QuantityUnitCode="kpl">1</InvoicedQuantity>
    <UnitPriceAmount AmountCurrencyIdentifier="EUR">25,00</UnitPriceAmount>
    <RowPositionIdentifier>2</RowPositionIdentifier>
    <RowDiscountPercent>40,000</RowDiscountPercent>
    <RowDiscountAmount AmountCurrencyIdentifier="EUR">10,00</RowDiscountAmount>
    <RowVatExcludedAmount AmountCurrencyIdentifier="EUR">15,00</RowVatExcludedAmount>
  </InvoiceRow>
</Finvoice>
