<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Everything hangs directly under the Vendor field rather than in a separate
        tab, so it is seen while the bill is being worked on.

        No server test can catch a modifier that is too permissive: `get_view`
        returns one arch for every record. Tests must evaluate a conditional
        element's modifier against a record of each state (see
        `tests/test_unmatched_vendor_ui.py::_element_invisible_for`).

        Plain arch only, no OWL widget: a form's field context is evaluated before
        the record is read, so the move id cannot be passed into the Vendor
        many2one; the candidates are shown beside the field instead.
    -->

    <record id="view_move_form_vendor_suggestions" model="ir.ui.view">
        <field name="name">account.move.form.vendor.suggestions</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- The widget makes this anchor unique in core's form; if it stops
                 matching, install fails loudly instead of the feature vanishing. -->
            <xpath expr="//field[@name='partner_id'][@widget='res_partner_many2one']"
                   position="after">
                <field name="ai_vendor_review_deferred" invisible="1"/>
                <field name="ai_from_import" invisible="1"/>
                <field name="ai_can_create_vendor" invisible="1"/>
                <field name="ai_vendor_draft_bill_count" invisible="1"/>

                <!-- Unmatched vendor: explanation and create button. Hidden on
                     bills not created by an import, where nothing was read. -->
                <!-- `groups` is on the container, not only on the fields: get_view
                     strips a restricted field but keeps modifiers that reference
                     it, which would make the client fail. -->
                <div class="o_ai_vendor_unmatched mb-2"
                     groups="account.group_account_invoice"
                     invisible="partner_id or not ai_from_import">
                    <span class="text-muted"
                          invisible="not ai_vendor_candidate_ids">
                        This vendor was not recognised, so the bill has no vendor.
                        Nothing was invented — pick one, or create the contact:
                    </span>
                    <span class="text-muted"
                          invisible="ai_vendor_candidate_ids">
                        This vendor was not recognised and nothing in the contact
                        book came close, so the bill has no vendor. Nothing was
                        invented — pick a vendor on the field above, or create the
                        contact from what was read off the document:
                    </span>
                    <!-- The method re-checks every visibility condition server-side. -->
                    <div class="mt-1" invisible="not ai_from_import or not ai_can_create_vendor">
                        <button name="action_ai_create_vendor_from_extraction"
                                type="object"
                                string="Create contact from this invoice"
                                class="btn btn-secondary btn-sm"
                                invisible="state != 'draft'"
                                help="Creates one contact from the name, address and tax id read off this document, files the bill against it, and records in the chatter who asked for it. If a matching contact already exists it is used instead, so pressing this twice cannot make two."/>
                    </div>
                </div>

                <!-- Candidate vendors, ranked by posted bills. A kanban rather
                     than a list so long, similar names wrap instead of being
                     truncated in the narrow column. There is no form for this
                     model, hence `can_open="false"`. -->
                <div class="o_ai_vendor_candidates mb-2"
                     groups="account.group_account_invoice"
                     invisible="partner_id or not ai_vendor_candidate_ids">
                    <field name="ai_vendor_candidate_ids" nolabel="1"
                           readonly="state != 'draft'"
                           options="{'no_create': True, 'no_open': True}">
                        <!-- Styled by static/src/scss/vendor_candidates.scss. -->
                        <kanban class="o_ai_vendor_candidate_cards"
                                create="false" delete="false"
                                quick_create="false" can_open="false"
                                records_draggable="false">
                            <field name="sequence"/>
                            <field name="partner_archived"/>
                            <field name="draft_bill_count"/>
                            <templates>
                                <t t-name="card"
                                   class="flex-row align-items-center gap-3">
                                    <div class="flex-grow-1">
                                        <div>
                                            <field name="partner_id" class="fw-bold"/>
                                            <span class="badge text-bg-warning ms-1"
                                                  invisible="not partner_archived">Archived</span>
                                        </div>
                                        <div class="text-muted small">
                                            <field name="reason"/>
                                        </div>
                                        <div class="text-muted small"
                                             invisible="not partner_location">
                                            <field name="partner_location"/>
                                        </div>
                                    </div>
                                    <div class="text-end flex-shrink-0">
                                        <div class="fs-5 fw-bold lh-1">
                                            <field name="bill_count"/>
                                        </div>
                                        <div class="text-muted small">posted</div>
                                        <div class="text-muted small lh-1"
                                             invisible="draft_bill_count == 0">
                                            <field name="draft_bill_count"/> draft
                                        </div>
                                    </div>
                                    <button name="action_use_this" type="object"
                                            string="Use this"
                                            class="btn btn-primary btn-sm flex-shrink-0"/>
                                </t>
                            </templates>
                        </kanban>
                    </field>
                </div>

                <!-- Matched vendor: how many posted bills exist for it. Zero is
                     shown as a warning, since it may mean the wrong contact was
                     picked. Only on imported bills.
                     `w-auto flex-grow-0 flex-shrink-0` on the field is needed
                     because core's field wrapper otherwise stretches to the full
                     column width. -->
                <div class="o_ai_vendor_bill_history mb-2"
                     invisible="not partner_id or not ai_from_import">
                    <div class="alert alert-warning py-1 px-2 mb-0
                                d-flex align-items-center flex-wrap gap-1"
                         role="status"
                         invisible="ai_vendor_bill_count != 0">
                        <i class="fa fa-exclamation-triangle"
                           role="img" aria-label="Warning" title="Warning"/>
                        <!-- Drafts are reported beside the zero-posted state, not
                             added to it. Separate spans because the arch has no
                             plural forms. -->
                        <span invisible="ai_vendor_draft_bill_count != 0">No posted bills from this vendor yet — check this is the right contact.</span>
                        <span invisible="ai_vendor_draft_bill_count != 1">No posted bills from this vendor yet, but there is 1 other draft — check this is the right contact.</span>
                        <span invisible="ai_vendor_draft_bill_count &lt; 2">No posted bills from this vendor yet, but there are</span>
                        <field name="ai_vendor_draft_bill_count" nolabel="1" readonly="1"
                               invisible="ai_vendor_draft_bill_count &lt; 2"
                               class="fw-bold w-auto flex-grow-0 flex-shrink-0"/>
                        <span invisible="ai_vendor_draft_bill_count &lt; 2">other drafts — check this is the right contact.</span>
                    </div>
                    <!-- Baseline alignment, because the field renders larger than
                         the `.small` text beside it. -->
                    <div class="text-muted small
                                d-flex align-items-baseline flex-wrap gap-1"
                         invisible="ai_vendor_bill_count == 0">
                        <field name="ai_vendor_bill_count" nolabel="1" readonly="1"
                               class="small fw-bold w-auto flex-grow-0 flex-shrink-0"/>
                        <span invisible="ai_vendor_bill_count != 1">posted bill from this vendor already.</span>
                        <span invisible="ai_vendor_bill_count == 1">posted bills from this vendor already.</span>
                    </div>
                </div>

                <!-- Details that conflict with the vendor record. Empty vendor
                     fields were already filled automatically. -->
                <div class="o_ai_vendor_conflicts alert alert-info py-1 px-2 mb-2
                            d-flex align-items-center flex-wrap gap-1"
                     role="status"
                     groups="account.group_account_invoice"
                     invisible="ai_vendor_suggestion_count == 0 or ai_vendor_review_deferred">
                    <field name="ai_vendor_suggestion_count" nolabel="1"
                           readonly="1"
                           class="fw-bold w-auto flex-grow-0 flex-shrink-0"/>
                    <span>details on this invoice differ from this vendor.</span>
                    <button name="action_ai_review_vendor_suggestions"
                            type="object" string="Review"
                            class="btn-link p-0 ms-1"/>
                    <button name="action_ai_defer_vendor_suggestions"
                            type="object" string="Not now"
                            class="btn-link p-0"
                            help="Leaves them pending. They go to the vendor-data queue, so this is never the same person's problem twice."/>
                </div>

                <!-- Printed total/tax differs from the bill's live figures. Clears
                     itself once the bill matches; does not block posting. -->
                <field name="ai_total_mismatch" invisible="1"/>
                <field name="ai_tax_mismatch" invisible="1"/>
                <div class="o_ai_total_mismatch alert alert-danger py-1 px-2 mb-2"
                     role="alert"
                     groups="account.group_account_invoice"
                     invisible="not ai_total_mismatch">
                    <i class="fa fa-exclamation-triangle me-1"
                       role="img" aria-label="Warning" title="Warning"/>
                    <span>The invoice total is</span>
                    <field name="ai_document_total" nolabel="1" readonly="1"
                           class="fw-bold d-inline-block w-auto ms-1"/>
                    <span class="text-nowrap ms-1" invisible="not ai_tax_mismatch">(tax<field
                        name="ai_document_tax" nolabel="1" readonly="1"
                        class="fw-bold d-inline-block w-auto ms-1"/>)</span>
                    <span>; this bill is</span>
                    <field name="amount_total" nolabel="1" readonly="1"
                           class="fw-bold d-inline-block w-auto ms-1"/>
                    <span class="text-nowrap ms-1" invisible="not ai_tax_mismatch">(tax<field
                        name="amount_tax" nolabel="1" readonly="1"
                        class="fw-bold d-inline-block w-auto ms-1"/>)</span>
                    <span>. Review before posting.</span>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
