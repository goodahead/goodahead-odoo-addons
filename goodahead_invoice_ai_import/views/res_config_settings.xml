<odoo>
    <!--
        The Claude API key, "Test Connection" and "Sync Models" are NOT here.
        `goodahead_claude` owns all three and renders them in its own settings
        block, against the same key and the same model registry. This adds only
        what is specific to reading invoices with Claude — which model to use
        for extraction, and which prompt — to the invoice-import block that
        `goodahead_invoice_import` declares.
    -->
    <record id="res_config_settings_view_form_ai" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.ai.invoice.import</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="goodahead_invoice_import.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='ai_public_email_domains_setting']" position="before">
                    <setting string="Extraction Model"
                             help="Claude model used to read invoice PDFs, overriding the company default set under Claude. Leave empty to use the company default. The model must support PDF input.">
                        <div class="content-group">
                            <div class="row mt16">
                                <label for="claude_invoice_model_id" class="col-lg-3 o_light_label"/>
                                <!-- The help text has always said the model must
                                     support PDF input; this is the first thing that
                                     makes it true. `_resolve_model` returns an
                                     EXPLICIT model untouched — that contract is what
                                     keeps fraud detection's pinned model working — so
                                     a non-PDF model chosen here would be sent as
                                     asked. The dropdown is where that gets prevented,
                                     and `pdf_supported` is maintained by Sync Models. -->
                                <field name="claude_invoice_model_id"
                                       domain="[('pdf_supported', '=', True)]"/>
                            </div>
                            <div class="mt16 text-muted">
                                The API key and the model list live under
                                <b>Settings &gt; Claude</b>. Run
                                <b>Sync Models</b> there before the first import,
                                or no model will resolve.
                            </div>
                        </div>
                    </setting>
                    <setting string="Extraction Prompt"
                             help="The country wording the invoice-reading prompt uses: tax, identifiers, bank details and payment references. Leave empty to choose it from the company's country.">
                        <div class="content-group">
                            <div class="row mt16">
                                <label for="ai_invoice_prompt_profile_id" class="col-lg-3 o_light_label"/>
                                <field name="ai_invoice_prompt_profile_id"
                                       placeholder="From the company's country"/>
                            </div>
                            <button type="action"
                                    name="%(goodahead_invoice_ai_import.action_prompt_profile)d"
                                    string="Manage Extraction Prompts"
                                    class="btn-link ps-0 mt8"
                                    icon="oi-arrow-right"/>
                        </div>
                    </setting>
            </xpath>
        </field>
    </record>
</odoo>
