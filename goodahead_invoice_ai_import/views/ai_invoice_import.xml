<odoo>
    <!--
        The import record's list, form, action and menu belong to
        `goodahead_invoice_import`. What the AI read adds to them is
        its model and its token usage, in the places they always stood.
    -->
    <record id="view_ai_invoice_import_tree_ai" model="ir.ui.view">
        <field name="name">goodahead.invoice.import.tree.ai</field>
        <field name="model">goodahead.invoice.import</field>
        <field name="inherit_id" ref="goodahead_invoice_import.view_ai_invoice_import_tree"/>
        <field name="arch" type="xml">
            <field name="move_id" position="after">
                <field name="extraction_model"/>
                <field name="input_tokens"/>
                <field name="output_tokens"/>
            </field>
        </field>
    </record>

    <record id="view_ai_invoice_import_form_ai" model="ir.ui.view">
        <field name="name">goodahead.invoice.import.form.ai</field>
        <field name="model">goodahead.invoice.import</field>
        <field name="inherit_id" ref="goodahead_invoice_import.view_ai_invoice_import_form"/>
        <field name="arch" type="xml">
            <!-- Retry is a new paid AI reading of the PDF; say so first. -->
            <xpath expr="//button[@name='action_retry']" position="attributes">
                <attribute name="confirm">Retry reads the PDF with the AI again, which is a paid call. Continue?</attribute>
            </xpath>
            <field name="xml_attachment_id" position="after">
                <field name="extraction_model"/>
                <field name="input_tokens"/>
                <field name="output_tokens"/>
            </field>
        </field>
    </record>
</odoo>
