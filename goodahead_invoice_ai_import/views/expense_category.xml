<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_expense_category_tree" model="ir.ui.view">
        <field name="name">goodahead.expense.category.tree</field>
        <field name="model">goodahead.expense.category</field>
        <field name="arch" type="xml">
            <!--
                `account_id` is company-dependent, so this list edits the account
                of the active company. With several companies selected, the edit
                lands on whichever one Odoo resolves first.
            -->
            <list editable="bottom" multi_edit="1">
                <field name="code"/>
                <field name="name"/>
                <field name="company_id" optional="show"
                       widget="many2one"
                       placeholder="All companies"/>
                <field name="account_id"
                       string="Expense Account (this company)"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="action_expense_category" model="ir.actions.act_window">
        <field name="name">Expense Categories</field>
        <field name="res_model">goodahead.expense.category</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Set an expense account for each category</p>
            <p>
                Categories are shared by every company; the <b>account</b> is
                per company, because the companies have different charts of
                accounts. The account column shows and edits the account of the
                company you are currently in — switch company to set the other
                one.
            </p>
            <p>
                A category with no account for the company a bill belongs to is
                not an error: the line falls back to the journal default, and
                the bill's chatter says so, naming the company.
            </p>
        </field>
    </record>

    <menuitem
        id="menu_ai_invoice_import_config"
        name="AI Invoice Import"
        parent="account.account_account_menu"
        sequence="100"
        groups="account.group_account_user,account.group_account_manager"
    />
    <menuitem
        id="menu_expense_category"
        name="Expense Categories"
        parent="menu_ai_invoice_import_config"
        action="action_expense_category"
        sequence="10"
    />
</odoo>
