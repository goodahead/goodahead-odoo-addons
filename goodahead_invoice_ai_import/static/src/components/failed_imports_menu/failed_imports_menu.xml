<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

<t t-name="goodahead_invoice_ai_import.FailedImportsMenu">
    <t t-if="state.isVisible and state.count > 0">
        <Dropdown position="'bottom-end'" beforeOpen.bind="fetchFailedImports" state="dropdown">
            <button class="btn" title="Failed AI Invoice Imports">
                <i class="fa fa-file-text-o text-danger" role="img" aria-label="Failed AI Invoice Imports"/>
                <span class="badge rounded-pill bg-danger ms-1"><t t-esc="state.count"/></span>
            </button>
            <t t-set-slot="content">
                <div class="o-failed-imports-menu d-flex flex-column" style="min-width: 320px; max-height: 400px;">
                    <div class="px-3 py-2 border-bottom bg-light">
                        <strong><t t-esc="state.count"/> Failed AI Import<t t-if="state.count !== 1">s</t></strong>
                    </div>
                    <div class="overflow-auto list-group list-group-flush">
                        <t t-foreach="state.imports" t-as="imp" t-key="imp.id">
                            <a href="#" class="list-group-item list-group-item-action p-2 px-3"
                               t-on-click.prevent="() => this.openImport(imp.id)">
                                <div class="fw-bold text-truncate" t-esc="imp.name"/>
                                <small class="text-danger d-block text-truncate" t-esc="imp.error"/>
                            </a>
                        </t>
                    </div>
                    <a href="#" class="px-3 py-2 border-top text-center text-primary fw-bold" t-on-click.prevent="openAllFailedImports">
                        View All
                    </a>
                </div>
            </t>
        </Dropdown>
    </t>
</t>

</templates>
