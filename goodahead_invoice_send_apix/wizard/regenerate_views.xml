<odoo>

    <!-- SCR-13 regenerate — valid / invalid: the message from the current
         data, checked against the Finvoice 3.0 schema; nothing sent. -->
    <record id="goodahead_invoice_send_regenerate_view_form" model="ir.ui.view">
        <field name="name">goodahead.invoice.send.regenerate.form</field>
        <field name="model">goodahead.invoice.send.regenerate</field>
        <field name="arch" type="xml">
            <form string="Regenerate and check">
                <div class="alert alert-success" role="status" invisible="schema_result != 'valid'">
                    Regenerated — the message passes the Finvoice 3.0 schema. Nothing was sent.
                </div>
                <div class="alert alert-danger" role="alert" invisible="schema_result != 'invalid'">
                    The message does not pass the Finvoice 3.0 schema. Nothing was sent.
                    <field name="problems" readonly="1" class="text-break"/>
                </div>
                <group>
                    <field name="move_id"/>
                    <field name="schema_result" widget="badge"
                           decoration-success="schema_result == 'valid'"
                           decoration-danger="schema_result == 'invalid'"/>
                    <field name="units_without_code" invisible="not units_without_code"/>
                    <field name="message_filename" invisible="1"/>
                    <field name="message_file" filename="message_filename"
                           invisible="not message_file"/>
                </group>
                <footer>
                    <button special="cancel" string="Close" class="btn-primary" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
