<odoo>

    <!-- SCR-03: the already-sent warning before a resend. -->
    <record id="goodahead_invoice_send_already_sent_view_form" model="ir.ui.view">
        <field name="name">goodahead.invoice.send.already.sent.form</field>
        <field name="model">goodahead.invoice.send.already.sent</field>
        <field name="arch" type="xml">
            <form string="Already sent">
                <field name="move_id" invisible="1"/>
                <div class="alert alert-warning" role="alert">
                    <field name="message" readonly="1" class="text-break"/>
                </div>
                <footer>
                    <button name="action_send_again" type="object" string="Send again"
                            class="btn-primary" data-hotkey="q"/>
                    <button special="cancel" string="Cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
