<templates xml:space="preserve">

    <t t-name="goodahead_invoice_send_apix.ApixSendRunStatus">
        <div class="o-apix-run-status w-100">
            <div t-if="unavailable" class="alert alert-warning o-apix-run-unavailable" role="alert">Status unavailable — the invoices keep sending in the background</div>
            <t t-set="status" t-value="state.status"/>
            <t t-if="status">
                <div t-if="status.waiting_for_worker and !finished" class="alert alert-warning o-apix-run-waiting" role="alert">
                    Waiting for the background worker — the invoices stay queued; you can close this window or cancel them on each invoice.
                </div>
                <div t-if="finished" class="alert alert-success o-apix-run-done" role="status" t-esc="summary"/>
                <div class="fw-bold mb-2 o-apix-run-progress"><t t-esc="status.done"/> / <t t-esc="status.total"/> done</div>
                <table class="table table-sm o-apix-run-table">
                    <tbody>
                        <tr t-foreach="status.lines" t-as="line" t-key="line.move_id" class="o-apix-run-row">
                            <td class="text-nowrap"><t t-esc="line.name"/></td>
                            <td class="text-muted"><t t-esc="line.company"/></td>
                            <td t-att-class="stateClass(line)" class="o-apix-run-state" t-esc="stateText(line)"/>
                            <td class="text-end text-nowrap">
                                <t t-if="line.can_retry">
                                    <button type="button" class="btn btn-link btn-sm o-apix-run-fix" t-on-click="() => this.fix(line)">Fix</button>
                                    <button type="button" class="btn btn-link btn-sm o-apix-run-retry" t-on-click="() => this.retry(line)">Retry</button>
                                </t>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </t>
        </div>
    </t>

</templates>
