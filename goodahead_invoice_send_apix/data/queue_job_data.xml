<odoo>

    <!-- events.md: background sends run on root.apix.send, under the APIX
         channel goodahead_apix owns, so receiving always keeps a slot.
         Capacity is a deploy setting (e.g. root.apix:3,root.apix.send:2). -->
    <record id="channel_apix_send" model="queue.job.channel">
        <field name="name">send</field>
        <field name="parent_id" ref="goodahead_apix.channel_apix"/>
    </record>

    <!-- apix.send.requested.v1: NO retry pattern. Once the APIX call may have
         started, a second call could deliver the invoice twice; the job
         records every failure itself and a dead job is released by the
         sweeper (send.ran_too_long). -->
    <record id="job_function_apix_send_queued" model="queue.job.function">
        <field name="model_id" ref="account.model_account_move"/>
        <field name="method">_apix_send_queued</field>
        <field name="channel_id" ref="channel_apix_send"/>
    </record>

</odoo>
