<odoo>

    <!-- The fix-it wizard for the company's own e-invoice address and operator,
         next to them; accounting administrators only. -->
    <record id="res_company_view_form_einvoice_lookup" model="ir.ui.view">
        <field name="name">res.company.form.einvoice.lookup</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="l10n_fi_edicode.res_company_view_form"/>
        <field name="arch" type="xml">
            <field name="einvoice_operator_id" position="after">
                <div colspan="2" class="o_row" groups="account.group_account_manager"
                     invisible="not id">
                    <button name="action_apix_open_einvoice_lookup" type="object"
                            string="Look up e-invoice address" icon="fa-search"
                            class="btn-link ps-0" groups="account.group_account_manager"/>
                </div>
            </field>
        </field>
    </record>

</odoo>
