<odoo>

    <!-- SCR-07: the migration tool of one company is not reachable from another. -->
    <record id="goodahead_apix_migration_company_rule" model="ir.rule">
        <field name="name">APIX migration tool: own companies only</field>
        <field name="model_id" ref="model_goodahead_apix_migration"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
