<odoo>

    <record id="goodahead_apix_connection_view_list" model="ir.ui.view">
        <field name="name">goodahead.apix.connection.list</field>
        <field name="model">goodahead.apix.connection</field>
        <field name="arch" type="xml">
            <list>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="environment"/>
                <field name="business_id"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'working'"
                       decoration-danger="status == 'rejected'"
                       decoration-muted="status == 'unchecked'"/>
                <field name="status_message"/>
                <field name="last_check_date"/>
            </list>
        </field>
    </record>

    <!-- SCR-05: administrators see and edit everything; billing users get the
         same form read-only (no write access) without the credential group. -->
    <record id="goodahead_apix_connection_view_form" model="ir.ui.view">
        <field name="name">goodahead.apix.connection.form</field>
        <field name="model">goodahead.apix.connection</field>
        <field name="arch" type="xml">
            <form string="APIX connection">
                <header>
                    <button name="action_check_connection" type="object" string="Check connection"
                            class="btn-primary" groups="account.group_account_manager"/>
                    <button name="action_open_fetch_credentials" type="object" string="Fetch from APIX login"
                            groups="account.group_account_manager"/>
                    <field name="status" widget="statusbar"/>
                </header>
                <div class="alert alert-success mb-0" role="status" invisible="status != 'working'">
                    <field name="status_message" readonly="1"/>
                </div>
                <div class="alert alert-danger mb-0" role="alert" invisible="status != 'rejected'">
                    <field name="status_message" readonly="1"/>
                </div>
                <div class="alert alert-info mb-0" role="status" invisible="status != 'unchecked' or not status_message">
                    <field name="status_message" readonly="1"/>
                </div>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="company_id" options="{'no_create': True}"/></h1>
                    </div>
                    <group>
                        <group string="Connection">
                            <field name="environment" widget="radio" options="{'horizontal': true}"/>
                            <field name="business_id" placeholder="1234567-8"/>
                        </group>
                        <group string="Transfer credentials" groups="account.group_account_manager">
                            <field name="transfer_id" password="True"/>
                            <field name="transfer_key" password="True"/>
                        </group>
                        <group string="Sending interface" name="sending_interface"
                               groups="account.group_account_manager">
                            <field name="interface_name"/>
                            <field name="interface_version"/>
                        </group>
                        <group string="Last check" name="last_check">
                            <field name="last_check_date"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="goodahead_apix_connection_action" model="ir.actions.act_window">
        <field name="name">APIX connection</field>
        <field name="res_model">goodahead.apix.connection</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Connect a company to APIX</p>
            <p>An accounting administrator enters the transfer credentials, or fetches them once with the company's APIX web login.</p>
        </field>
    </record>

</odoo>
