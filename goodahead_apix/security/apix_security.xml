<odoo>

    <record id="goodahead_apix_connection_company_rule" model="ir.rule">
        <field name="name">APIX connection: allowed companies</field>
        <field name="model_id" ref="model_goodahead_apix_connection"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="goodahead_apix_fetch_credentials_company_rule" model="ir.rule">
        <field name="name">Fetch APIX credentials: allowed companies</field>
        <field name="model_id" ref="model_goodahead_apix_fetch_credentials"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
