<odoo>

    <!-- SCR-06 -->
    <record id="goodahead_apix_fetch_credentials_view_form" model="ir.ui.view">
        <field name="name">goodahead.apix.fetch.credentials.form</field>
        <field name="model">goodahead.apix.fetch.credentials</field>
        <field name="arch" type="xml">
            <form string="Fetch from APIX login">
                <div class="alert alert-danger" role="alert" invisible="not error_message">
                    <field name="error_message"/>
                </div>
                <field name="connection_id" invisible="1"/>
                <group>
                    <field name="company_id" readonly="connection_id" options="{'no_create': True}"
                           groups="base.group_multi_company"/>
                    <field name="environment" widget="radio" options="{'horizontal': true}"/>
                    <field name="email" required="1" placeholder="name@example.test"/>
                    <field name="password" password="True" required="1"/>
                    <field name="business_id" required="1" placeholder="1234567-8"/>
                </group>
                <div class="text-muted">The password is used once and not stored.</div>
                <footer>
                    <button name="action_fetch" type="object" string="Fetch credentials" class="btn-primary"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
